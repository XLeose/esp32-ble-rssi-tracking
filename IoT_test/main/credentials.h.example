#ifndef CREDENTIALS_H
#define CREDENTIALS_H

// Wi-Fi Configuration
#define WIFI_SSID       "YOUR_WIFI_SSID"
#define WIFI_PASS       "YOUR_WIFI_PASSWORD"

// MQTT Broker Configuration (Raspberry Pi Mosquitto IP or Broker URI)
// NOTE: For local network Mosquitto, use plain TCP "mqtt://<PI_IP>" (port 1883).
// Avoid using "mqtts://" unless TLS/SSL is explicitly configured.
#define BROKER_URI      "mqtt://YOUR_MQTT_BROKER_IP" // e.g. "mqtt://192.168.1.100"
#define BROKER_USERNAME "YOUR_MQTT_USERNAME"
#define BROKER_PASS     "YOUR_MQTT_PASSWORD"

// Scanner Device Identification / Location Tag
#define DEVICE_NAME     "YOUR_SCANNER_DEVICE_NAME"   // e.g. "WORK_AREA", "ROOM_A", "OFFICE_ENTRANCE"

#endif // CREDENTIALS_H
